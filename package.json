{
  "name": "@myrmidon/gve-snapshot-rendition",
  "version": "0.0.4",
  "homepage": "https://github.com/vedph/gve-snapshot-rendition",
  "repository": {
    "type": "git",
    "url": "https://github.com/vedph/gve-snapshot-rendition"
  },
  "author": "Daniele Fusi",
  "license": "",
  "description": "Web components for rendering interactive text transformations with hint designer. This package is an early version published for internal evaluation and staging use only. A final open-source license will be published later.",
  "keywords": [
    "snapshot",
    "rendition",
    "VEdition",
    "genetic-philology",
    "hint-designer",
    "text-transformation"
  ],
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "start": "concurrently \"rollup -c -w\" \"lite-server\"",
    "start:designer": "concurrently \"rollup -c -w\" \"lite-server -c bs-config.designer.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-ui": "vitest --ui",
    "prepublishOnly": "npm run test && npm run build",
    "prepack": "npm run build",
    "publish:public": "npm publish --access=public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "fast-diff": "^1.3.0",
    "feather-icons": "^4.29.2",
    "gsap": "^3.14.2",
    "highlight.js": "^11.11.1",
    "split.js": "^1.6.5",
    "svg-pan-zoom": "^3.6.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/ui": "^4.0.16",
    "concurrency": "^0.1.4",
    "concurrently": "^9.2.1",
    "lite-server": "^2.6.1",
    "rollup": "^4.55.1",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-arm64-msvc": "^4.55.1"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node"
    }
  }
}
